<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Proxy</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 20px;
        }
        input {
            margin: 10px;
            padding: 10px;
            width: 300px;
        }
        button {
            padding: 10px 20px;
            cursor: pointer;
        }
        iframe {
            width: 80%;
            height: 500px;
            border: none;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>Simple Web Proxy</h1>
    <p>Enter a URL to load it through this simple proxy:</p>
    <input type="text" id="urlInput" placeholder="Enter URL">
    <button onclick="loadProxy()">Go</button>
    <iframe id="proxyFrame"></iframe>

    <script>
        async function loadProxy() {
            const url = document.getElementById('urlInput').value;
            const proxyFrame = document.getElementById('proxyFrame');

            if (url) {
                try {
                    // Proxy service endpoint (replace with your proxy server if needed)
                    const proxyUrl = 'https://cors-anywhere.herokuapp.com/';
                    
                    // Make the fetch request with headers
                    const response = await fetch(proxyUrl + url, {
                        method: 'GET',
                        headers: {
                            'Origin': window.location.origin,
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (response.ok) {
                        // If successful, set the iframe source to the proxy URL
                        proxyFrame.src = proxyUrl + url;
                    } else {
                        alert(`Error loading the URL: ${response.status} ${response.statusText}`);
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("An error occurred while loading the URL!");
                }
            } else {
                alert("Please enter a valid URL!");
            }
        }
    </script>
</body>
</html>
