const canvas = document.getElementById('gameCanvas');
const gl = canvas.getContext('webgl');

// Initialize game state
let player = { x: 0, y: 0, speed: 0.1 };
let keys = {};

// Handle key presses
window.addEventListener('keydown', (e) => keys[e.key] = true);
window.addEventListener('keyup', (e) => keys[e.key] = false);

// Game loop
function gameLoop() {
    if (keys['w']) player.y += player.speed; // Move forward
    if (keys['s']) player.y -= player.speed; // Move backward
    if (keys['a']) player.x -= player.speed; // Move left
    if (keys['d']) player.x += player.speed; // Move right
    if (keys['Shift']) player.speed = 0.2; // Run
    else player.speed = 0.1; // Walk

    // Update the game (rendering, AI, etc.)
    render();
    requestAnimationFrame(gameLoop);
}

